DATABASE_URL="postgresql://postgres:postgres@localhost:5432/super_family_tasks?schema=public"

# Set this to postgres when you want local app requests to use DATABASE_URL.
# Production automatically uses PostgreSQL when DATABASE_URL is present.
# STORAGE_MODE="postgres"

# Required in production. Generate one with: npm run auth:secret
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional. Set this in production if the app code directory is replaced during deployment.
# SUPER_FAMILY_DATA_DIR="/var/lib/super-family-tasks"

# Optional. Local preview and production start default to 3035.
# SUPER_FAMILY_PREVIEW_PORT=3035
# SUPER_FAMILY_START_PORT=3035
