# Vercel PostgreSQL connection string. Use the pooled URL for runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
STORAGE_MODE="postgres"

# Copy this file to .env.production and replace the placeholder.
AUTH_SECRET="replace-with-the-output-of-npm-run-auth-secret"

# Set this to false only when you are testing the app over plain HTTP on a server IP.
# Leave it true for HTTPS domains.
AUTH_COOKIE_SECURE="true"
